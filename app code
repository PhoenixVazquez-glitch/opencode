import { useState } from 'react'; import { Text, View, TextInput, Button, Image, ScrollView } from 'react-native'; const API='http://localhost:4000'; let token=''; export default function App(){const [s,setS]=useState('login');const [email,setE]=useState('test@auric.io');const [pass,setP]=useState('test123');const [data,setD]=useState({});const call=async(p,b)=>{const r=await fetch(API+p,{method:b?'POST':'GET',headers:{'Content-Type':'application/json','Authorization':'Bearer '+token},body:b?JSON.stringify(b):null});return r.json()};const login=async()=>{const r=await call('/v1/login',{email,pass});token=r.token;setD(r);setS('home')};const signup=async()=>{const r=await call('/v1/signup',{email,pass,esign:true});token=r.token;setD(r);setS('home')};const oracle=async()=>setD({...data,oracle:await call('/v1/oracle')});const drop=async()=>setD({...data,drop:await call('/v1/gold-drop/enter',{})});if(s=='login')return<View style={{flex:1,justifyContent:'center',padding:20}}><Text>Auric Signet</Text><TextInput placeholder="email" onChangeText={setE} value={email} style={{borderWidth:1,margin:8}}/><TextInput placeholder="pass" onChangeText={setP} value={pass} secureTextEntry style={{borderWidth:1,margin:8}}/><Button title="Login" onPress={login}/><Button title="Signup" onPress={signup}/></View>;return<ScrollView style={{flex:1,padding:20,marginTop:40}}><Text>Welcome {email}</Text><Image source={{uri:API+'/v1/signet/'+data.signet}} style={{width:100,height:100}}/><Button title="Get Oracle" onPress={oracle}/><Text>{JSON.stringify(data.oracle)}</Text><Button title="Enter Gold Drop" onPress={drop}/><Text>{JSON.stringify(data.drop)}</Text><Button title="Deposit $10k Mock" onPress={()=>call('/v1/deposit',{asset:'USD',amount:10000})}/></ScrollView>}
