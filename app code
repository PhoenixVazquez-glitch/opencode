const express = require('express'); const cors = require('cors'); const sqlite3 = require('sqlite3').verbose(); const jwt = require('jsonwebtoken'); const bcrypt = require('bcryptjs'); const crypto = require('crypto'); const app = express(); app.use(cors()); app.use(express.json()); const db = new sqlite3.Database(':memory:'); const JWT_SECRET = 'dev'; db.serialize(()=>{db.run('CREATE TABLE users (id INTEGER PRIMARY KEY, email TEXT, pass TEXT, signet TEXT, vip INTEGER DEFAULT 0, created INTEGER)');db.run('CREATE TABLE ledger (id INTEGER PRIMARY KEY, user_id INT, asset TEXT, amount REAL)');db.run('CREATE TABLE tickets (id INTEGER PRIMARY KEY, user_id INT, round TEXT, created INTEGER)');}); const auth=(req,res,next)=>{const t=req.headers.authorization?.split(' ')[1];if(!t)return res.status(401).send();try{req.user=jwt.verify(t,JWT_SECRET);next()}catch{res.status(401).send()}};app.post('/v1/signup',(req,res)=>{const {email,pass,esign}=req.body;const hash=bcrypt.hashSync(pass,8);const signet=crypto.createHash('sha256').update(email+Date.now()).digest('hex').slice(0,8);db.run('INSERT INTO users(email,pass,signet,created) VALUES (?,?,?,?)',[email,hash,signet,Date.now()],function(err){if(err)return res.status(400).send();const token=jwt.sign({id:this.lastID,email},JWT_SECRET);res.json({token,signet})})});app.post('/v1/login',(req,res)=>{db.get('SELECT * FROM users WHERE email=?',[req.body.email],(e,u)=>{if(!u||!bcrypt.compareSync(req.body.pass,u.pass))return res.status(401).send();res.json({token:jwt.sign({id:u.id,email:u.email},JWT_SECRET),signet:u.signet})})});app.get('/v1/balance',auth,(req,res)=>{db.all('SELECT asset,SUM(amount) as bal FROM ledger WHERE user_id=? GROUP BY asset',[req.user.id],(e,r)=>res.json(r))});app.post('/v1/deposit',auth,(req,res)=>{db.run('INSERT INTO ledger(user_id,asset,amount) VALUES (?,?,?)',[req.user.id,req.body.asset,req.body.amount],()=>res.json({ok:1}))});app.post('/v1/borrow',auth,(req,res)=>{db.run('INSERT INTO ledger(user_id,asset,amount) VALUES (?,?,?), (?,?,?)',[req.user.id,'USD',req.body.amount,req.user.id,'LOAN',-req.body.amount],()=>res.json({ok:1,note:'50% LTV check mocked'}))});app.get('/v1/oracle',auth,(req,res)=>res.json({base:{p:68,text:'Ranges likely. LTV safe. +$240'},bull:{p:18,text:'ETF inflow. +$1200'},risk:{p:14,text:'CPI hot. Fortify'},ts:Date.now()}));app.post('/v1/gold-drop/enter',auth,(req,res)=>{const round=new Date().toISOString().slice(0,7);db.run('INSERT INTO tickets(user_id,round,created) VALUES (?,?,?)',[req.user.id,round,Date.now()],()=>res.json({tickets:3}))});app.get('/v1/signet/:id',(req,res)=>{res.setHeader('Content-Type','image/svg+xml');res.send(`<svg width="256" height="256" xmlns="http://www.w3.org/2000/svg"><defs><radialGradient id="g"><stop offset="0%" stop-color="#F5C84C"/><stop offset="100%" stop-color="#0A0B0F"/></radialGradient></defs><rect width="256" height="256" fill="url(#g)"/><text x="50%" y="50%" font-size="80" text-anchor="middle" fill="#0A0B0F" font-family="monospace">${req.params.id}</text></svg>`) });app.listen(4000,()=>console.log('Auric API :4000'));
EOF
